<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Strength pipeline, every 30 minutes, Mac mini only (user patrikpen).
  Install:   cp tools/launchd/com.dash.strength-pipeline.plist ~/Library/LaunchAgents/
             launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.dash.strength-pipeline.plist
  Run now:   launchctl kickstart -k gui/$(id -u)/com.dash.strength-pipeline
  Remove:    launchctl bootout gui/$(id -u)/com.dash.strength-pipeline
  Log:       ~/.claude/cache/daily-dashboard/strength/cron.log (script rotates it at 1 MB)
  launchd does not expand ~ or $HOME in these values, hence the absolute paths.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dash.strength-pipeline</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/patrikpen/daily-dashboard/tools/strength_cron.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/patrikpen/daily-dashboard</string>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin</string>
    <key>HOME</key>
    <string>/Users/patrikpen</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/patrikpen/.claude/cache/daily-dashboard/strength/cron.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/patrikpen/.claude/cache/daily-dashboard/strength/cron.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
